# ─── Fincra sandbox configuration ─────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# SECRET key — server/scripts ONLY. It deliberately has NO `EXPO_PUBLIC_`
# prefix: Expo inlines every `EXPO_PUBLIC_*` variable into the JS bundle.
# Used only by `npm run checkout-link` (scripts/create-checkout-link.mjs).
FINCRA_SANDBOX_API_KEY=your_fincra_sandbox_secret_key

# PUBLIC key (pk_...) — safe to ship in the app (inline checkout).
EXPO_PUBLIC_FINCRA_SANDBOX_PUB_KEY=pk_test_your_public_key

# Redirect URL registered with the hosted checkout link.
EXPO_PUBLIC_FINCRA_REDIRECT_URL=https://myapp.com/callback

# Hosted checkout link created server-side (paste the output of
# `npm run checkout-link`). You can also paste a link in the app at runtime.
EXPO_PUBLIC_FINCRA_CHECKOUT_URL=
